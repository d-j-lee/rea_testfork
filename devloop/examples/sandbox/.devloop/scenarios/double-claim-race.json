{
  "name": "double-claim-race",
  "description": "같은 계정의 두 세션이 동시에 수령 요청: 정확히 1건만 성공해야 한다 (REQ-3). 경합은 확률적이므로 반복해 분포를 본다.",
  "requirements": ["REQ-3"],
  "adapter": "sandbox",
  "actors": {"a": {"account": "race_${run_id}"}, "b": {"account": "race_${run_id}"}},
  "steps": [
    {"actor": "a", "op": "login", "save": {"uid": "$.user_id"}},
    {"actor": "b", "op": "login"},
    {"repeat": 10, "note": "set progress, then two simultaneous claims", "steps": [
      {"actor": "a", "op": "gm", "args": {"cmd": "set_progress", "mission": 102, "value": 5}},
      {"parallel": [
         {"actor": "a", "op": "claim", "args": {"mission": 102}},
         {"actor": "b", "op": "claim", "args": {"mission": 102}}],
       "expect_all": [{"count": {"path": "$.ok", "op": "eq", "value": true}, "op": "eq", "value": 1}]}
    ]}
  ]
}
